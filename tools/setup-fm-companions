#!/usr/bin/env bash
set -euo pipefail

install_dir="${FM_CAREER_COMPANIONS_DIR:-$HOME/.local/share/fm-career-mcp/companions}"
mkdir -p "$install_dir"
workspace=$(mktemp -d)
trap 'rm -rf "$workspace"' EXIT

checkout() {
    local url=$1 revision=$2 dest=$3
    git init -q "$dest"
    git -C "$dest" fetch -q --depth 1 "$url" "$revision"
    git -C "$dest" checkout -q --detach FETCH_HEAD
    test "$(git -C "$dest" rev-parse HEAD)" = "$revision"
}

case "${1:-}" in
    napas)
        if [ -x "$install_dir/napas-fm-mcp" ]; then
            printf '%s\n' "$install_dir/napas-fm-mcp"
            exit
        fi
        checkout https://github.com/Napas/fm-mcp.git 6988631f8120d807b3941869b527d9204b66f7b8 "$workspace/napas"
        (cd "$workspace/napas" && go build -o "$workspace/napas-fm-mcp" ./cmd/fm-mcp)
        install -m 755 "$workspace/napas-fm-mcp" "$install_dir/napas-fm-mcp"
        printf '%s\n' "$install_dir/napas-fm-mcp"
        ;;
    matchlens)
        if [ -x "$install_dir/matchlens/packages/mcp/bin/fmmi-mcp.mjs" ]; then
            printf '%s\n' "$install_dir/matchlens/packages/mcp/bin/fmmi-mcp.mjs"
            exit
        fi
        checkout https://github.com/ianderse/FMMatchLens_MCP.git f1b83606f605791ff0531059ccbb8f3717cb137d "$workspace/matchlens"
        (cd "$workspace/matchlens" && npm ci --ignore-scripts && npm rebuild better-sqlite3 && node -e 'new (require("better-sqlite3"))(":memory:").close()')
        mv "$workspace/matchlens" "$install_dir/matchlens"
        printf '%s\n' "$install_dir/matchlens/packages/mcp/bin/fmmi-mcp.mjs"
        ;;
    trainer)
        if [ "$(uname -s)" != Darwin ]; then
            printf 'Live Trainer setup requires macOS.\n' >&2
            exit 2
        fi
        app="$HOME/Applications/FM27 Trainer.app"
        if [ ! -d "$app" ]; then
            image="$workspace/FM27-Trainer-macOS.dmg"
            curl --fail --silent --show-error --location \
                https://github.com/SemHiel2003/fm27-trainer/releases/download/v0.2.4/FM27-Trainer-macOS.dmg -o "$image"
            printf '%s  %s\n' cdecbc14e811a66ce9753ecd192333ab606eb9c628c64573c779650355353f72 "$image" | shasum -a 256 -c -
            mount="$workspace/trainer"
            mkdir "$mount"
            hdiutil attach "$image" -readonly -nobrowse -mountpoint "$mount" >/dev/null
            trap 'hdiutil detach "$mount" >/dev/null && rm -rf "$workspace"' EXIT
            codesign --verify --deep --strict "$mount/FM27 Trainer.app"
            mkdir -p "$HOME/Applications"
            ditto "$mount/FM27 Trainer.app" "$app"
        fi
        codesign --verify --deep --strict "$app"
        printf '%s\n' "$app"
        ;;
    all)
        "$0" napas
        "$0" matchlens
        if [ "$(uname -s)" = Darwin ]; then
            "$0" trainer
        fi
        ;;
    *)
        printf 'Usage: %s napas|matchlens|trainer|all\n' "$0" >&2
        exit 2
        ;;
esac
