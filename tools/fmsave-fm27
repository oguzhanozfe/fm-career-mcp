#!/usr/bin/env python3
"""Local read-only match report compatibility for FM27 27.0.1+2503222."""

import sys
from dataclasses import replace

from fmsave import __version__
from fmsave import _save
from fmsave._errors import UnsupportedGameError
from fmsave._layouts.fm27_27_0_0 import MATCH_REPORTS
from fmsave.cli import main

compatible_layout = replace(MATCH_REPORTS)
original_layout = _save.find_match_report_layout
original_read = _save.read_team_match_stats


def match_layout(game, schema, build, *, known_build):
    if (game, schema, build) == ("FM27", 6, "27.0.1+2503222"):
        return compatible_layout
    return original_layout(game, schema, build, known_build=known_build)


def read_match_stats(section, layout, file_name):
    rows, stats = original_read(section, layout, file_name)
    if layout is compatible_layout and (
        stats.entries != stats.decompressed or stats.incomplete or stats.without_header
    ):
        raise UnsupportedGameError("Match reports failed structural validation")
    return rows, stats


if __version__ == "0.12.2" and sys.argv[1:2] == ["export"] and sys.argv[3:4] == ["team-match-stats"]:
    _save.find_match_report_layout = match_layout
    _save.read_team_match_stats = read_match_stats

sys.exit(main())
